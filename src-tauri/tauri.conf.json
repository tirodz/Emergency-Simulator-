{
  "$schema":"https://schema.tauri.app/config/2",
  "productName":"Emergency Simulator",
  "version":"1.0.0",
  "identifier":"com.tirod.emergency-simulator",
  "build":{"frontendDist":"../src"},
  "app":{
    "withGlobalTauri":true,
    "windows":[{
      "label":"main",
      "title":"Emergency Simulator — Android Alert Lab",
      "width":1180,
      "height":720,
      "minWidth":980,
      "minHeight":620,
      "resizable":true,
      "decorations":false,
      "transparent":true,
      "center":true,"maximized":false
    }],
    "security":{"csp":"default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"}
  },
  "bundle":{
    "active":true,
    "targets":["nsis"],
    "icon":["icons/icon.ico","icons/icon.png"],
    "resources":{
      "../android/local-simulator/app/build/outputs/apk/debug/app-debug.apk":"android/local-simulator.apk",
      "../packaging/platform-tools/adb.exe":"adb/adb.exe",
      "../packaging/platform-tools/AdbWinApi.dll":"adb/AdbWinApi.dll",
      "../packaging/platform-tools/AdbWinUsbApi.dll":"adb/AdbWinUsbApi.dll"
    },
    "windows":{"nsis":{"installMode":"currentUser","displayLanguageSelector":false}}
  }
}