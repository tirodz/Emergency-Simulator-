# Build outputs
build/
dist/

# Gradle's per-project cache and the machine-specific SDK path written by the Android build.
# `build/` above already covers the APK output tree; these two are the other generated artefacts
# that must never be committed.
.gradle/
local.properties

# Rust/Tauri build tree. `src-tauri/Cargo.lock` IS committed: this is an application, and pinning
# the dependency graph is what stops a fresh CI run from silently resolving a dependency whose
# minimum Rust version is newer than the pinned toolchain.
src-tauri/target/

# ACL/capability schemas generated by the Tauri build script.
src-tauri/gen/

# Internal staging for the Windows build (Platform Tools are downloaded at build time and are not
# committed: they are a third-party binary distribution).
packaging/platform-tools/

# Runtime
logs/
__pycache__/
*.pyc
.venv/

# The Android injector is a build output of the Android SDK, but the *committed* dex jar is a build
# input for the desktop release: packaging it is what lets a user run the tool without a JDK or the
# Android SDK. android/alertinject/.gitignore un-ignores that one file for exactly this reason.
!/android/alertinject/out/
!/android/alertinject/out/alertinject.jar
bridge-token.txt
evidence/

# The rendered one-paste, which carries the live token. Never committed.
docs/connect-one-paste.local.md
artifacts/
